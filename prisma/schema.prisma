// prisma/schema.prisma
// Sistema Web U.E. "Los Ángeles de Nazaria Ignacia"
// Versión v6 — sobre v5: FK compuesta (cursoId, gestionId) -> Curso en
// Inscripcion y DocenteMateriaCurso, para que Postgres garantice que
// gestionId siempre coincide con la gestión real del curso (ya no
// depende de que el servicio valide). Se documentan los invariantes que
// quedan a cargo del servicio (contexto académico cruzado en Asistencia
// y afines, y quién recalcula ResumenAsistencia/Calificacion).

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════
// ENUMS
// ══════════════════════════════════════

enum Rol {
  DIRECTOR
  SECRETARIA
  DOCENTE
  ESTUDIANTE
  TUTOR
}

enum EstadoInscripcion {
  ACTIVA
  RETIRADA
  TRANSFERIDA
  CONCLUIDA
}

// TODO: confirmar contra el acta de centralización real del colegio si
// dice "Reprobado" o "No promovido" — es la palabra que se imprime en el
// boletín oficial, tiene que coincidir exacto. Sigue pendiente.
enum Resultado {
  PENDIENTE
  PROMOVIDO
  REPROBADO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  RETRASO
  JUSTIFICADO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  QR
}

enum EstadoPago {
  PAGADO
  PARCIAL
  PENDIENTE
  ANULADO
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum Nivel {
  PRIMARIA
  SECUNDARIA
}

enum Turno {
  MANANA
  TARDE
  NOCHE
}

enum Parentesco {
  PADRE
  MADRE
  ABUELO
  ABUELA
  TIO
  TIA
  HERMANO
  HERMANA
  TUTOR_LEGAL
  OTRO
}

enum Dependencia {
  FISCAL
  CONVENIO
  PRIVADO
}

enum TipoValorConfig {
  TEXTO
  ENTERO
  DECIMAL
  BOOLEANO
  JSON
}

// ══════════════════════════════════════
// CONFIGURACIÓN DEL SISTEMA
// ══════════════════════════════════════
// Clave-valor para parámetros que el director puede cambiar sin redeploy.
model Configuracion {
  clave         String          @id
  valor         String
  tipo          TipoValorConfig @default(TEXTO)
  descripcion   String?
  actualizadoEn DateTime        @updatedAt
}

// ══════════════════════════════════════
// INSTITUCIÓN
// ══════════════════════════════════════

model Institucion {
  id           Int          @id @default(1)
  nombre       String
  direccion    String?
  telefono     String?
  email        String?
  rue          String?
  logoUrl      String?
  municipio    String?
  departamento String?
  dependencia  Dependencia?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

// ══════════════════════════════════════
// AUTENTICACIÓN
// ══════════════════════════════════════

model Usuario {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  passwordHash     String
  roles            Rol[]
  activo           Boolean   @default(true)
  ultimoAcceso     DateTime?
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  director   Director?
  secretaria Secretaria?
  docente    Docente?
  estudiante Estudiante?
  tutor      Tutor?

  pagosRegistrados    Pago[]
  cambiosCalificacion HistorialCalificacion[]
  notasRegistradas    NotaActividad[]

  @@index([activo])
}

// ══════════════════════════════════════
// PERSONA COMPARTIDA
// ══════════════════════════════════════

model Persona {
  id              Int       @id @default(autoincrement())
  ci              String?   @unique
  nombre          String
  apellido        String
  sexo            Sexo?
  fechaNacimiento DateTime? @db.Date
  direccion       String?
  telefono        String?
  email           String?
  nacionalidad    String?   @default("Boliviana")
  fotoUrl         String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  director   Director?
  secretaria Secretaria?
  docente    Docente?
  estudiante Estudiante?
  tutor      Tutor?

  @@index([nombre, apellido])
}

// ══════════════════════════════════════
// PERFILES
// ══════════════════════════════════════

model Director {
  id        Int     @id @default(autoincrement())
  personaId Int     @unique
  activo    Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Restrict)
  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  gestiones Gestion[]
}

model Secretaria {
  id        Int     @id @default(autoincrement())
  personaId Int     @unique
  activo    Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Restrict)
  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
}

model Docente {
  id           Int     @id @default(autoincrement())
  personaId    Int     @unique
  especialidad String?
  activo       Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Restrict)
  usuarioId Int?     @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  asignaciones     DocenteMateriaCurso[]
  cursosTutoreados Curso[]               @relation("CursoTutorDocente")
}

model Estudiante {
  id               Int     @id @default(autoincrement())
  rude             String? @unique
  personaId        Int     @unique
  lugarNacimiento  String?
  idiomaMaterno    String? @default("Castellano")
  idiomaHablado    String? @default("Castellano")
  discapacidad     Boolean @default(false)
  tipoDiscapacidad String?
  activo           Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Restrict)
  usuarioId Int?     @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  inscripciones Inscripcion[]
  tutores       TutorEstudiante[]

  @@index([activo])
}

model Tutor {
  id               Int     @id @default(autoincrement())
  personaId        Int     @unique
  ocupacion        String?
  gradoInstruccion String?
  activo           Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Restrict)
  usuarioId Int?     @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  estudiantes TutorEstudiante[]
}

model TutorEstudiante {
  id                Int        @id @default(autoincrement())
  tutorId           Int
  estudianteId      Int
  parentesco        Parentesco
  esTutorPrincipal  Boolean    @default(false)
  esApoderado       Boolean    @default(false)
  viveConEstudiante Boolean    @default(true)

  creadoEn DateTime @default(now())

  tutor      Tutor      @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([tutorId, estudianteId])
  @@index([estudianteId])
}

// ══════════════════════════════════════
// ESTRUCTURA ACADÉMICA
// ══════════════════════════════════════

model Gestion {
  id                   Int       @id @default(autoincrement())
  anio                 Int       @unique
  descripcion          String?
  activa               Boolean   @default(false)
  fechaInicio          DateTime? @db.Date
  fechaFin             DateTime? @db.Date
  notaMinimaAprobacion Decimal   @default(51) @db.Decimal(5, 2)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  directorId Int?
  director   Director? @relation(fields: [directorId], references: [id], onDelete: SetNull)

  cursos        Curso[]
  trimestres    Trimestre[]
  inscripciones Inscripcion[]
  asignaciones  DocenteMateriaCurso[]
  conceptosPago ConceptoPago[]
  dimensiones   DimensionEvaluacion[]

  @@index([activa])
}

// `@@unique([id, gestionId])` es el ancla: le permite a Inscripcion y a
// DocenteMateriaCurso referenciar "este curso Y esta gestión" como una
// sola FK compuesta, así Postgres rechaza cualquier fila cuyo gestionId
// no coincida con el del curso real.
model Curso {
  id        Int     @id @default(autoincrement())
  nivel     Nivel
  grado     Int
  paralelo  String
  turno     Turno   @default(MANANA)
  capacidad Int?
  activo    Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id], onDelete: Restrict)

  tutorDocenteId Int?
  tutorDocente   Docente? @relation("CursoTutorDocente", fields: [tutorDocenteId], references: [id], onDelete: SetNull)

  inscripciones Inscripcion[]
  asignaciones  DocenteMateriaCurso[]

  @@unique([nivel, grado, paralelo, turno, gestionId])
  @@unique([id, gestionId])
  @@index([gestionId])
  @@index([activo])
}

model CampoSaber {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  orden  Int     @default(0)
  activo Boolean @default(true)

  materias Materia[]

  @@index([activo])
}

model Materia {
  id             Int     @id @default(autoincrement())
  nombre         String
  codigo         String  @unique
  horasSemanales Int     @default(4)
  campoSaberId   Int?
  activo         Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  campoSaber   CampoSaber?           @relation(fields: [campoSaberId], references: [id], onDelete: SetNull)
  asignaciones DocenteMateriaCurso[]

  @@index([campoSaberId])
  @@index([activo])
}

model Trimestre {
  id          Int      @id @default(autoincrement())
  numero      Int
  nombre      String
  fechaInicio DateTime @db.Date
  fechaFin    DateTime @db.Date
  cerrado     Boolean  @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id], onDelete: Restrict)

  calificaciones         Calificacion[]
  actividadesEvaluativas ActividadEvaluativa[]
  bitacoras              BitacoraClase[]
  resumenAsistencias     ResumenAsistencia[]
  asistencias            Asistencia[]

  @@unique([numero, gestionId])
  @@unique([id, gestionId])
  @@index([gestionId])
}

// ══════════════════════════════════════
// INSCRIPCIÓN
// ══════════════════════════════════════
// `gestionId` ya NO es un dato que el servicio deba "acordarse" de
// validar: `curso` es una FK COMPUESTA (cursoId, gestionId) -> Curso(id,
// gestionId). Si gestionId no coincide con la gestión real del curso,
// Postgres rechaza el INSERT/UPDATE directamente.
model Inscripcion {
  id                Int               @id @default(autoincrement())
  fechaInscripcion  DateTime          @default(now()) @db.Date
  estadoInscripcion EstadoInscripcion @default(ACTIVA)
  fechaRetiro       DateTime?         @db.Date
  resultado         Resultado         @default(PENDIENTE)
  observaciones     String?
  procedencia       String?
  gestionId         Int

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudianteId Int
  cursoId      Int

  estudiante Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  curso      Curso      @relation(fields: [cursoId, gestionId], references: [id, gestionId], onDelete: Restrict)
  gestion    Gestion    @relation(fields: [gestionId], references: [id], onDelete: Restrict)

  asistencias        Asistencia[]
  calificaciones     Calificacion[]
  notasActividad     NotaActividad[]
  promediosFinales   PromedioFinal[]
  resumenAsistencias ResumenAsistencia[]
  pagos              Pago[]

  @@unique([estudianteId, gestionId])
  @@unique([id, gestionId]) // ancla para una futura FK compuesta desde Asistencia/Calificacion, si se decide cerrar el punto 3 a nivel de BD
  @@index([cursoId])
  @@index([estadoInscripcion])
}

// ══════════════════════════════════════
// DOCENTE — MATERIA — CURSO
// ══════════════════════════════════════
// Mismo mecanismo que Inscripcion: `curso` es FK compuesta contra
// Curso(id, gestionId) — gestionId no puede divergir del curso real.
model DocenteMateriaCurso {
  id Int @id @default(autoincrement())

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  docenteId Int
  materiaId Int
  cursoId   Int
  gestionId Int

  docente Docente @relation(fields: [docenteId], references: [id], onDelete: Restrict)
  materia Materia @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  curso   Curso   @relation(fields: [cursoId, gestionId], references: [id, gestionId], onDelete: Restrict)
  gestion Gestion @relation(fields: [gestionId], references: [id], onDelete: Restrict)

  horarios               Horario[]
  asistencias            Asistencia[]
  calificaciones         Calificacion[]
  promediosFinales       PromedioFinal[]
  resumenAsistencias     ResumenAsistencia[]
  bitacoras              BitacoraClase[]
  actividadesEvaluativas ActividadEvaluativa[]

  @@unique([docenteId, materiaId, cursoId, gestionId])
  @@unique([id, gestionId]) // ancla, mismo motivo que en Inscripcion
  @@index([docenteId])
  @@index([cursoId])
  @@index([materiaId])
}

// ══════════════════════════════════════
// HORARIOS
// ══════════════════════════════════════

model Horario {
  id         Int       @id @default(autoincrement())
  diaSemana  DiaSemana
  horaInicio DateTime  @db.Time
  horaFin    DateTime  @db.Time
  aula       String?

  creadoEn DateTime @default(now())

  docenteMateriaCursoId Int
  docenteMateriaCurso   DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id], onDelete: Cascade)

  @@unique([docenteMateriaCursoId, diaSemana, horaInicio])
  @@index([docenteMateriaCursoId])
}

// ══════════════════════════════════════
// ASISTENCIA
// ══════════════════════════════════════
// INVARIANTE DE SERVICIO (no garantizado por Postgres todavía):
// inscripcion, docenteMateriaCurso y trimestre deben pertenecer a la
// MISMA gestión. La FK compuesta de Curso protege Inscripcion↔Curso y
// DMC↔Curso por separado, pero no obliga a que esos dos, más el
// Trimestre elegido, coincidan entre sí en una misma fila de Asistencia.
// Todo servicio que cree/edite Asistencia, Calificacion, NotaActividad,
// PromedioFinal, ActividadEvaluativa o ResumenAsistencia DEBE pasar por
// un único validador — p.ej. assertMismoContextoAcademico(inscripcionId,
// docenteMateriaCursoId, trimestreId) — antes del write. Si más adelante
// se quiere esta garantía a nivel de BD, el camino es propagar gestionId
// + FK compuesta hacia estas tablas usando los anclas @@unique([id,
// gestionId]) ya dejados en Curso/Inscripcion/DocenteMateriaCurso.
model Asistencia {
  id            Int              @id @default(autoincrement())
  fecha         DateTime         @db.Date
  estado        EstadoAsistencia
  justificacion String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  inscripcionId         Int
  docenteMateriaCursoId Int
  trimestreId           Int

  inscripcion         Inscripcion         @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  docenteMateriaCurso DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id], onDelete: Restrict)
  trimestre           Trimestre           @relation(fields: [trimestreId], references: [id], onDelete: Restrict)

  @@unique([inscripcionId, docenteMateriaCursoId, fecha])
  @@index([fecha])
  @@index([inscripcionId])
  @@index([estado])
  @@index([trimestreId])
}

// Snapshot, no fuente de verdad. ÚNICO escritor: recalcularResumenAsistencia().
// Se dispara al crear/editar una Asistencia y al cerrar el trimestre. Una
// vez Trimestre.cerrado = true, el valor queda congelado — así el
// boletín ya impreso no cambia si alguien corrige una asistencia después.
model ResumenAsistencia {
  id               Int     @id @default(autoincrement())
  totalClases      Int     @default(0)
  totalPresente    Int     @default(0)
  totalAusente     Int     @default(0)
  totalRetraso     Int     @default(0)
  totalJustificado Int     @default(0)
  porcentaje       Decimal @default(0) @db.Decimal(5, 2)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  inscripcionId         Int
  docenteMateriaCursoId Int
  trimestreId           Int

  inscripcion         Inscripcion         @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  docenteMateriaCurso DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id], onDelete: Restrict)
  trimestre           Trimestre           @relation(fields: [trimestreId], references: [id], onDelete: Restrict)

  @@unique([inscripcionId, docenteMateriaCursoId, trimestreId])
  @@index([trimestreId])
}

// ══════════════════════════════════════
// CALIFICACIONES POR DIMENSIÓN
// ══════════════════════════════════════
// Cadena: Gestion → DimensionEvaluacion → ActividadEvaluativa →
// NotaActividad. NotaActividad es la ÚNICA fuente de verdad de la nota;
// Calificacion.promedioTrimestral es un snapshot cuyo ÚNICO escritor es
// recalcularCalificacion(). Una vez Trimestre.cerrado = true, cualquier
// corrección pasa obligatoriamente por HistorialCalificacion — nunca un
// UPDATE directo sobre promedioTrimestral.

model DimensionEvaluacion {
  id             Int     @id @default(autoincrement())
  gestionId      Int
  nombre         String
  puntajeMaximo  Decimal @db.Decimal(5, 2)
  pesoEnPromedio Decimal @default(1) @db.Decimal(4, 3)
  orden          Int
  esAutoevaluada Boolean @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  gestion                 Gestion                 @relation(fields: [gestionId], references: [id], onDelete: Restrict)
  actividadesEvaluativas  ActividadEvaluativa[]
  calificacionesDimension CalificacionDimension[]

  @@unique([gestionId, nombre])
  @@index([gestionId])
}

model ActividadEvaluativa {
  id              Int      @id @default(autoincrement())
  nombre          String
  fecha           DateTime @default(now()) @db.Date
  puntajeMaximo   Decimal  @db.Decimal(5, 2)
  peso            Decimal  @default(1) @db.Decimal(4, 3)
  esRecuperatorio Boolean  @default(false)
  activo          Boolean  @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  docenteMateriaCursoId Int
  trimestreId           Int
  dimensionId           Int

  docenteMateriaCurso DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id], onDelete: Restrict)
  trimestre           Trimestre           @relation(fields: [trimestreId], references: [id], onDelete: Restrict)
  dimension           DimensionEvaluacion @relation(fields: [dimensionId], references: [id], onDelete: Restrict)

  notas NotaActividad[]

  @@index([docenteMateriaCursoId, trimestreId])
  @@index([dimensionId])
  @@index([activo])
}

model NotaActividad {
  id                    Int     @id @default(autoincrement())
  actividadEvaluativaId Int
  inscripcionId         Int
  nota                  Decimal @db.Decimal(5, 2)
  observacion           String?
  registradoPorId       Int?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  actividadEvaluativa ActividadEvaluativa @relation(fields: [actividadEvaluativaId], references: [id], onDelete: Restrict)
  inscripcion         Inscripcion         @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  registradoPor       Usuario?            @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@unique([actividadEvaluativaId, inscripcionId])
  @@index([inscripcionId])
  @@index([actividadEvaluativaId])
}

model BitacoraClase {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @default(now()) @db.Date
  tema          String
  descripcion   String?
  tareaAsignada String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  docenteMateriaCursoId Int
  docenteMateriaCurso   DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id], onDelete: Restrict)

  trimestreId Int?
  trimestre   Trimestre? @relation(fields: [trimestreId], references: [id], onDelete: SetNull)

  @@index([docenteMateriaCursoId, fecha])
  @@index([trimestreId])
}

model Calificacion {
  id                 Int      @id @default(autoincrement())
  promedioTrimestral Decimal? @db.Decimal(5, 2)

  registradoEn  DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  inscripcionId         Int
  docenteMateriaCursoId Int
  trimestreId           Int

  inscripcion         Inscripcion         @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  docenteMateriaCurso DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id], onDelete: Restrict)
  trimestre           Trimestre           @relation(fields: [trimestreId], references: [id], onDelete: Restrict)

  dimensiones CalificacionDimension[]
  historial   HistorialCalificacion[]

  @@unique([inscripcionId, docenteMateriaCursoId, trimestreId])
  @@index([trimestreId])
  @@index([inscripcionId])
}

model CalificacionDimension {
  id             Int     @id @default(autoincrement())
  calificacionId Int
  dimensionId    Int
  promedio       Decimal @db.Decimal(5, 2)

  calificacion Calificacion        @relation(fields: [calificacionId], references: [id], onDelete: Restrict)
  dimension    DimensionEvaluacion @relation(fields: [dimensionId], references: [id], onDelete: Restrict)

  @@unique([calificacionId, dimensionId])
  @@index([dimensionId])
}

model HistorialCalificacion {
  id               Int      @id @default(autoincrement())
  promedioAnterior Decimal? @db.Decimal(5, 2)
  promedioNuevo    Decimal  @db.Decimal(5, 2)
  motivo           String?
  fecha            DateTime @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  calificacionId Int
  calificacion   Calificacion @relation(fields: [calificacionId], references: [id], onDelete: Cascade)

  @@index([calificacionId])
  @@index([usuarioId])
}

model PromedioFinal {
  id            Int       @id @default(autoincrement())
  promedioFinal Decimal   @db.Decimal(5, 2)
  resultado     Resultado @default(PENDIENTE)

  calculadoEn   DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  inscripcionId         Int
  docenteMateriaCursoId Int

  inscripcion         Inscripcion         @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  docenteMateriaCurso DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id], onDelete: Restrict)

  @@unique([inscripcionId, docenteMateriaCursoId])
  @@index([inscripcionId])
}

// ══════════════════════════════════════
// PAGOS
// ══════════════════════════════════════
// Dinero SIEMPRE Decimal(10,2) — nunca Float.

model ConceptoPago {
  id               Int       @id @default(autoincrement())
  nombre           String
  descripcion      String?
  monto            Decimal   @db.Decimal(10, 2)
  obligatorio      Boolean   @default(true)
  fechaVencimiento DateTime? @db.Date
  aplicarMora      Boolean   @default(false)
  porcentajeMora   Decimal   @default(0) @db.Decimal(5, 2)
  activo           Boolean   @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id], onDelete: Restrict)

  pagos Pago[]

  @@index([gestionId])
  @@index([activo])
}

model Pago {
  id            Int        @id @default(autoincrement())
  montoOriginal Decimal    @db.Decimal(10, 2)
  descuento     Decimal    @default(0) @db.Decimal(10, 2)
  montoPagado   Decimal    @db.Decimal(10, 2)
  fechaPago     DateTime   @default(now()) @db.Date
  metodoPago    MetodoPago @default(EFECTIVO)
  estado        EstadoPago @default(PAGADO)
  numeroRecibo  String?    @unique
  serieRecibo   String?    @default("A")
  observaciones String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  inscripcionId   Int
  conceptoPagoId  Int
  registradoPorId Int?

  inscripcion   Inscripcion  @relation(fields: [inscripcionId], references: [id], onDelete: Restrict)
  conceptoPago  ConceptoPago @relation(fields: [conceptoPagoId], references: [id], onDelete: Restrict)
  registradoPor Usuario?     @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([inscripcionId])
  @@index([conceptoPagoId])
  @@index([estado])
  @@index([fechaPago])
}
