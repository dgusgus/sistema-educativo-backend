// prisma/schema.prisma
// Sistema Web U.E. "Los Ángeles de Nazaria Ignacia"
// Versión final — incluye Institución, Auditoría, EstadoInscripcion e HistorialCalificacion

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════
// ENUMS
// ══════════════════════════════════════

enum Rol {
  DIRECTOR
  SECRETARIA
  DOCENTE
  ESTUDIANTE
  TUTOR
}

// ¿Por qué dos enums para inscripción?
// EstadoInscripcion → qué está pasando AHORA (durante el año)
// Resultado         → cómo TERMINÓ el año
// Son preguntas diferentes y necesitan campos separados
enum EstadoInscripcion {
  ACTIVA       // estudiando normalmente
  RETIRADA     // padres lo retiraron del colegio
  TRANSFERIDA  // se fue a otra unidad educativa
  CONCLUIDA    // terminó el año académico
}

enum Resultado {
  PENDIENTE   // el año aún no terminó
  PROMOVIDO   // aprobó y pasa al siguiente curso
  REPROBADO   // no alcanzó el mínimo requerido
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  QR
}

enum EstadoPago {
  PAGADO
  PENDIENTE
  ANULADO
}

// ══════════════════════════════════════
// INSTITUCIÓN
// ¿Por qué? Los datos del colegio no deben estar
// hardcodeados en el código — deben venir de la BD
// ¿Para qué? Boletines, reportes y encabezados
// dinámicos que el Director puede actualizar
// ══════════════════════════════════════

model Institucion {
  id        Int     @id @default(1) // solo hay UNA institución
  nombre    String
  direccion String?
  telefono  String?
  email     String?
  rue       String? // Registro Único Educativo
  logoUrl   String? // para el boletín PDF
  municipio String?
  departamento String?

  // Auditoría
  actualizadoEn DateTime @updatedAt
}

// ══════════════════════════════════════
// AUTENTICACIÓN
// ══════════════════════════════════════

model Usuario {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  passwordHash  String
  rol           Rol
  activo        Boolean  @default(true)

  // Auditoría — ¿cuándo se creó y modificó esta cuenta?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Cada usuario tiene UN solo perfil según su rol
  director   Director?
  secretaria Secretaria?
  docente    Docente?
  estudiante Estudiante?
  tutor      Tutor?

  // Registros relacionados
  pagosRegistrados     Pago[]
  cambiosCalificacion  HistorialCalificacion[]
}

// ══════════════════════════════════════
// PERFILES — uno por cada rol
// ¿Por qué tablas separadas?
// Cada rol tiene datos específicos distintos:
//   Director   → gestionId (a cargo de qué año)
//   Docente    → especialidad
//   Estudiante → fechaNacimiento, dirección
//   Tutor      → parentesco
// ══════════════════════════════════════

model Director {
  id       Int     @id @default(autoincrement())
  ci       String  @unique
  nombre   String
  apellido String
  telefono String?
  email    String?
  activo   Boolean @default(true)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  // @unique porque solo UN director puede estar a cargo de una gestión
  gestionId Int?    @unique
  gestion   Gestion? @relation(fields: [gestionId], references: [id])
}

model Secretaria {
  id       Int     @id @default(autoincrement())
  ci       String  @unique
  nombre   String
  apellido String
  telefono String?
  email    String?
  activo   Boolean @default(true)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model Docente {
  id           Int     @id @default(autoincrement())
  ci           String  @unique
  nombre       String
  apellido     String
  especialidad String?
  telefono     String?
  email        String?
  activo       Boolean @default(true)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // opcional — un docente puede existir sin cuenta aún
  usuarioId Int?    @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  asignaciones DocenteMateriaCurso[]
}

model Estudiante {
  id              Int       @id @default(autoincrement())
  ci              String    @unique
  nombre          String
  apellido        String
  fechaNacimiento DateTime?
  direccion       String?
  activo          Boolean   @default(true)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // opcional — un estudiante puede existir sin cuenta
  usuarioId Int?    @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  inscripciones Inscripcion[]
  tutores       TutorEstudiante[]
}

model Tutor {
  id         Int     @id @default(autoincrement())
  ci         String  @unique
  nombre     String
  apellido   String
  telefono   String?
  email      String?
  parentesco String? // Madre, Padre, Abuelo, Tutor legal, etc.

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // opcional — un tutor puede existir sin cuenta
  usuarioId Int?    @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  estudiantes TutorEstudiante[]
}

model TutorEstudiante {
  id           Int @id @default(autoincrement())
  tutorId      Int
  estudianteId Int

  // Auditoría
  creadoEn DateTime @default(now())

  tutor      Tutor      @relation(fields: [tutorId], references: [id])
  estudiante Estudiante @relation(fields: [estudianteId], references: [id])

  @@unique([tutorId, estudianteId])
}

// ══════════════════════════════════════
// ESTRUCTURA ACADÉMICA
// ══════════════════════════════════════

model Gestion {
  id          Int       @id @default(autoincrement())
  anio        Int       @unique
  descripcion String?
  activa      Boolean   @default(false)
  fechaInicio DateTime?
  fechaFin    DateTime?

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // El director a cargo de este año
  director      Director?
  cursos        Curso[]
  trimestres    Trimestre[]
  inscripciones Inscripcion[]
  asignaciones  DocenteMateriaCurso[]
  conceptosPago ConceptoPago[]
}

model Curso {
  id       Int    @id @default(autoincrement())
  nombre   String
  nivel    String  // "Primero Secundaria"
  paralelo String  // "A", "B", "C"

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id])

  inscripciones Inscripcion[]
  asignaciones  DocenteMateriaCurso[]

  @@unique([nivel, paralelo, gestionId])
}

model Materia {
  id             Int    @id @default(autoincrement())
  nombre         String
  codigo         String @unique
  horasSemanales Int    @default(4)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  asignaciones DocenteMateriaCurso[]
}

model Trimestre {
  id          Int       @id @default(autoincrement())
  numero      Int       // 1, 2 o 3
  nombre      String
  fechaInicio DateTime?
  fechaFin    DateTime?
  cerrado     Boolean   @default(false)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id])

  calificaciones     Calificacion[]
  resumenAsistencias ResumenAsistencia[]

  @@unique([numero, gestionId])
}

// ══════════════════════════════════════
// INSCRIPCIÓN
// ¿Por qué dos campos de estado?
//   estadoInscripcion → qué pasa DURANTE el año
//   resultado         → cómo TERMINÓ el año
// Ejemplo: un estudiante puede estar RETIRADA
// (se fue en junio) y su resultado final
// quedaría PENDIENTE porque nunca terminó el año
// ══════════════════════════════════════

model Inscripcion {
  id               Int                @id @default(autoincrement())
  fechaInscripcion DateTime           @default(now())

  // Estado actual durante el año
  estadoInscripcion EstadoInscripcion @default(ACTIVA)
  fechaRetiro       DateTime?          // si se retiró o transfirió

  // Resultado al final del año
  resultado        Resultado          @default(PENDIENTE)
  observaciones    String?

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  estudianteId Int
  cursoId      Int
  gestionId    Int

  estudiante Estudiante @relation(fields: [estudianteId], references: [id])
  curso      Curso      @relation(fields: [cursoId], references: [id])
  gestion    Gestion    @relation(fields: [gestionId], references: [id])

  asistencias        Asistencia[]
  calificaciones     Calificacion[]
  promediosFinales   PromedioFinal[]
  resumenAsistencias ResumenAsistencia[]
  pagos              Pago[]

  @@unique([estudianteId, gestionId])
}

// ══════════════════════════════════════
// DOCENTE — MATERIA — CURSO
// El núcleo del sistema académico
// "Juan Mamani da Matemáticas en 1ro Sec A en 2025"
// Todo lo académico (asistencia, notas, actividades)
// pasa por esta tabla
// ══════════════════════════════════════

model DocenteMateriaCurso {
  id Int @id @default(autoincrement())

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  docenteId Int
  materiaId Int
  cursoId   Int
  gestionId Int

  docente Docente @relation(fields: [docenteId], references: [id])
  materia Materia @relation(fields: [materiaId], references: [id])
  curso   Curso   @relation(fields: [cursoId], references: [id])
  gestion Gestion @relation(fields: [gestionId], references: [id])

  horarios           Horario[]
  asistencias        Asistencia[]
  calificaciones     Calificacion[]
  promediosFinales   PromedioFinal[]
  resumenAsistencias ResumenAsistencia[]
  actividades        Actividad[]

  @@unique([docenteId, materiaId, cursoId, gestionId])
}

// ══════════════════════════════════════
// HORARIOS
// ══════════════════════════════════════

model Horario {
  id         Int       @id @default(autoincrement())
  diaSemana  DiaSemana
  horaInicio String    // "08:00"
  horaFin    String    // "09:00"
  aula       String?

  // Auditoría
  creadoEn DateTime @default(now())

  docenteMateriaCursoId Int
  docenteMateriaCurso   DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id])

  @@unique([docenteMateriaCursoId, diaSemana, horaInicio])
}

// ══════════════════════════════════════
// ASISTENCIA
// ══════════════════════════════════════

model Asistencia {
  id            Int              @id @default(autoincrement())
  fecha         DateTime
  estado        EstadoAsistencia
  justificacion String?

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  inscripcionId         Int
  docenteMateriaCursoId Int

  inscripcion         Inscripcion         @relation(fields: [inscripcionId], references: [id])
  docenteMateriaCurso DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id])

  @@unique([inscripcionId, docenteMateriaCursoId, fecha])
}

model ResumenAsistencia {
  id               Int   @id @default(autoincrement())
  totalClases      Int   @default(0)
  totalPresente    Int   @default(0)
  totalAusente     Int   @default(0)
  totalJustificado Int   @default(0)
  porcentaje       Float @default(0)

  // Auditoría
  actualizadoEn DateTime @updatedAt

  inscripcionId         Int
  docenteMateriaCursoId Int
  trimestreId           Int

  inscripcion         Inscripcion         @relation(fields: [inscripcionId], references: [id])
  docenteMateriaCurso DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id])
  trimestre           Trimestre           @relation(fields: [trimestreId], references: [id])

  @@unique([inscripcionId, docenteMateriaCursoId, trimestreId])
}

// ══════════════════════════════════════
// CALIFICACIONES
// ══════════════════════════════════════

model Calificacion {
  id                 Int      @id @default(autoincrement())
  nota               Float    // escala 1-100 conforme Ley 070
  promedioTrimestral Float?

  // Auditoría
  registradoEn  DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  inscripcionId         Int
  docenteMateriaCursoId Int
  trimestreId           Int

  inscripcion         Inscripcion         @relation(fields: [inscripcionId], references: [id])
  docenteMateriaCurso DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id])
  trimestre           Trimestre           @relation(fields: [trimestreId], references: [id])

  // Historial de cambios de esta calificación
  historial HistorialCalificacion[]

  @@unique([inscripcionId, docenteMateriaCursoId, trimestreId])
}

// ══════════════════════════════════════
// HISTORIAL DE CALIFICACIONES
// ¿Por qué? Si un docente cambia una nota de 45 a 75
// no hay forma de saber que existió el 45.
// ¿Para qué? El Director puede auditar todos los cambios
// de notas — quién cambió, cuándo y de cuánto a cuánto.
// Esto es importante para evitar irregularidades y dar
// transparencia al proceso de evaluación.
// ══════════════════════════════════════

model HistorialCalificacion {
  id           Int      @id @default(autoincrement())
  notaAnterior Float
  notaNueva    Float
  motivo       String?  // "Error de transcripción", "Revisión de examen", etc.
  fecha        DateTime @default(now())

  // Quién hizo el cambio
  usuarioId      Int
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])

  // Qué calificación se cambió
  calificacionId Int
  calificacion   Calificacion @relation(fields: [calificacionId], references: [id])
}

model PromedioFinal {
  id            Int     @id @default(autoincrement())
  promedioFinal Float
  aprobado      Boolean @default(false)

  // Auditoría
  calculadoEn   DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  inscripcionId         Int
  docenteMateriaCursoId Int

  inscripcion         Inscripcion         @relation(fields: [inscripcionId], references: [id])
  docenteMateriaCurso DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id])

  @@unique([inscripcionId, docenteMateriaCursoId])
}

// ══════════════════════════════════════
// ACTIVIDADES
// ══════════════════════════════════════

model Actividad {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @default(now())
  tema          String
  descripcion   String?
  tareaAsignada String?

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  docenteMateriaCursoId Int
  docenteMateriaCurso   DocenteMateriaCurso @relation(fields: [docenteMateriaCursoId], references: [id])
}

// ══════════════════════════════════════
// PAGOS
// ══════════════════════════════════════

model ConceptoPago {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String?
  monto       Float
  obligatorio Boolean @default(true)

  // Auditoría
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  gestionId Int
  gestion   Gestion @relation(fields: [gestionId], references: [id])

  pagos Pago[]
}

model Pago {
  id            Int        @id @default(autoincrement())
  montoPagado   Float
  fechaPago     DateTime   @default(now())
  metodoPago    MetodoPago @default(EFECTIVO)
  estado        EstadoPago @default(PAGADO)
  numeroRecibo  String?    @unique
  observaciones String?

  // Auditoría
  creadoEn DateTime @default(now())

  inscripcionId   Int
  conceptoPagoId  Int
  registradoPorId Int?

  inscripcion   Inscripcion  @relation(fields: [inscripcionId],   references: [id])
  conceptoPago  ConceptoPago @relation(fields: [conceptoPagoId],  references: [id])
  registradoPor Usuario?     @relation(fields: [registradoPorId], references: [id])
}
