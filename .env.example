DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Contraseña de PostgreSQL para docker-compose (debe coincidir con la de DATABASE_URL)
POSTGRES_PASSWORD="cambia_esto"

# Solo si el servidor está detrás de un proxy (nginx, Render, Railway...): cantidad de proxies.
# Déjalo comentado si NO hay proxy.
# TRUST_PROXY=1

# ─── Semillas (prisma/seed*.ts) ───────────────────────────────────────────────
# DEMO / desarrollo (pnpm db:seed). Todo opcional:
# SEED_ANCLA=2025-08-31          # "hoy" de la simulación (por defecto, la fecha real). Esa fecha reproduce el dataset fijo anterior
# SEED_PASSWORD_DEMO=            # una sola clave para TODAS las cuentas demo (solo para un demo público)
# SEED_PERMITIR_PRODUCCION=si    # únicamente para un demo público con NODE_ENV=production
# SEED_FORZAR=si                 # sembrar sobre una base que ya tiene personas (no recomendado)
#
# PRIMER ARRANQUE de un servidor REAL (pnpm db:seed:prod). Obligatorias; NO las dejes en el repositorio:
# SEED_ADMIN_USERNAME=director
# SEED_ADMIN_PASSWORD=           # 12 a 72 caracteres, única (no la de la demo)
# SEED_ADMIN_CI=
# SEED_ADMIN_NOMBRE=
# SEED_ADMIN_APELLIDO=
# SEED_ADMIN_EMAIL=              # opcional
# SEED_ADMIN_TELEFONO=           # opcional
